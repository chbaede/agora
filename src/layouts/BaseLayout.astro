---
import '../styles/global.css';
import '../styles/print.css';
import { getAllIssues } from '../data/load-issues';
import { getAllMathPacks } from '../data/load-math';

interface Props {
  title: string;
  description?: string;
  currentIssueId?: string;
  activeNav?: 'latest' | 'archive' | 'glossary' | 'math';
}

const {
  title,
  description = 'AGORA — Weekly US & European Current Affairs, Science, Economics & BIS Grade 8 Math Digest',
  currentIssueId,
  activeNav = 'latest',
} = Astro.props;

const allIssues = getAllIssues();
const allMathPacks = getAllMathPacks();
const isMathMode = activeNav === 'math';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body data-lang="en">
    <header class="utility-bar no-print">
      <div class="utility-inner">
        <div class="utility-left">
          <a href="/" class="brand-pill">
            <span class="brand-dot"></span>
            <span class="brand-text">AGORA</span>
          </a>

          <!-- Primary 2-Track Switcher (Global News vs BIS Grade 8 Math) -->
          <div class="track-switcher" role="navigation" aria-label="Subject Track Switcher">
            <a href="/" class={`track-pill ${!isMathMode ? 'active' : ''}`}>
              🌍 <span class="lang-en-inline">News</span><span class="lang-ko-inline">국제 뉴스</span>
            </a>
            <a href="/math" class={`track-pill ${isMathMode ? 'active-math' : ''}`}>
              📐 <span class="lang-en-inline">Math 8</span><span class="lang-ko-inline">8학년 수학</span>
            </a>
          </div>

          <nav class="nav-links desktop-only-nav" aria-label="Main Navigation">
            <a href="/archive" class={`nav-link ${activeNav === 'archive' ? 'active' : ''}`}>
              <span class="lang-en-inline">Archive ({allIssues.length})</span>
              <span class="lang-ko-inline">지난호 ({allIssues.length})</span>
            </a>
            <a href="/glossary" class={`nav-link ${activeNav === 'glossary' ? 'active' : ''}`}>
              <span class="lang-en-inline">Vocab</span>
              <span class="lang-ko-inline">단어장</span>
            </a>
          </nav>
        </div>

        <div class="utility-controls">
          <div class="lang-switcher" role="group" aria-label="Language Mode Switcher">
            <button type="button" class="lang-btn active" data-lang-switch="en" title="Student Mode: English Only">
              <span class="desktop-label">🇺🇸 EN</span>
              <span class="mobile-label">EN</span>
            </button>
            <button type="button" class="lang-btn" data-lang-switch="ko" title="Parent Mode: Korean Only">
              <span class="desktop-label">🇰🇷 한국어</span>
              <span class="mobile-label">한</span>
            </button>
            <button type="button" class="lang-btn" data-lang-switch="bilingual" title="Family Mode: English + Korean">
              <span class="desktop-label">🇺🇸+🇰🇷 한영</span>
              <span class="mobile-label">한영</span>
            </button>
          </div>

          <label class="issue-switcher-label desktop-only-ctrl" for="issue-quick-select">
            <select id="issue-quick-select" class="issue-select" aria-label="Quick jump to any issue">
              {isMathMode
                ? allMathPacks.map((pack) => (
                    <option value={`/math/weeks/${pack.id}`} selected={pack.id === currentIssueId}>
                      #{pack.weekNumber} ({pack.id})
                    </option>
                  ))
                : allIssues.map((iss) => (
                    <option value={`/issues/${iss.id}`} selected={iss.id === currentIssueId}>
                      #{iss.issueNumber} ({iss.id})
                    </option>
                  ))}
            </select>
          </label>

          <button
            type="button"
            id="btn-print-daily-top"
            class="btn-print"
            title="Print current day's sheet as a 1-Sheet (2-Page Duplex) B&W Handout"
          >
            🖨️ <span class="desktop-label"><span class="lang-en-inline">Print 1-Sheet (Duplex)</span><span class="lang-ko-inline">오늘 분량 양면 인쇄 (2p)</span></span><span class="mobile-label">🖨️</span>
          </button>

          <button
            type="button"
            id="btn-print-packet"
            class="btn-print-daily desktop-only-ctrl"
            title="Print All 7 Days (Full Weekly Packet)"
          >
            🗂️ <span class="desktop-label"><span class="lang-en-inline">Print All Week</span><span class="lang-ko-inline">주간 전체 인쇄</span></span>
          </button>

          <button
            type="button"
            id="btn-mobile-menu"
            class="btn-mobile-menu mobile-only-ctrl"
            aria-label="Toggle Menu"
            aria-expanded="false"
          >
            ☰
          </button>
        </div>
      </div>

      <!-- Compact Mobile Drawer (Hidden by default, opens on ☰ tap) -->
      <div id="mobile-nav-drawer" class="mobile-nav-drawer" hidden>
        <div class="mobile-drawer-row">
          <label for="issue-quick-select-mobile" style="font-size: 0.78rem; font-weight: 700;">
            Select Week:
          </label>
          <select id="issue-quick-select-mobile" class="issue-select" style="max-width: 200px;">
            {isMathMode
              ? allMathPacks.map((pack) => (
                  <option value={`/math/weeks/${pack.id}`} selected={pack.id === currentIssueId}>
                    Math Week #{pack.weekNumber} ({pack.id}) · {pack.publishDate}
                  </option>
                ))
              : allIssues.map((iss) => (
                  <option value={`/issues/${iss.id}`} selected={iss.id === currentIssueId}>
                    Issue #{iss.issueNumber} ({iss.id}) · {iss.publishDate}
                  </option>
                ))}
          </select>
        </div>
        <nav class="mobile-drawer-links" aria-label="Mobile Navigation">
          <a href="/" class={`nav-link ${activeNav === 'latest' ? 'active' : ''}`}>🌍 Global News</a>
          <a href="/math" class={`nav-link ${activeNav === 'math' ? 'active' : ''}`}>📐 Grade 8 Math</a>
          <a href="/archive" class={`nav-link ${activeNav === 'archive' ? 'active' : ''}`}>
            🗂️ Past Issues ({allIssues.length})
          </a>
          <a href="/glossary" class={`nav-link ${activeNav === 'glossary' ? 'active' : ''}`}>
            🧠 Vocab Bank
          </a>
        </nav>
      </div>
    </header>

    <main class="page-shell">
      <slot />

      <footer class="site-footer">
        <div>
          <strong>AGORA (`agora.yocto.kr`)</strong> — Weekly Global Current Affairs, Science, Economics &amp; BIS Grade 8 Math Digest.
        </div>
        <div>
          Published Mondays at 04:00 CET/CEST · <a href="/">Global News</a> · <a href="/math">Grade 8 Math</a> · <a href="/archive">Archive</a> · <a href="/glossary">Glossary</a>
        </div>
      </footer>
    </main>

    <div id="term-popover" class="term-popover no-print" role="status" aria-live="polite">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem;">
        <strong id="popover-word" style="font-size:0.95rem; color:#FDE68A;">Term</strong>
        <button id="popover-close" type="button" style="background:none; border:none; color:#CBD5E1; cursor:pointer; font-size:0.9rem;">✕</button>
      </div>
      <div id="popover-def" style="font-size:0.86rem; line-height:1.45;"></div>
    </div>

    <script is:inline>
      (function () {
        // Automatically adapt root-relative links & select options when hosted under /agora/ subpath on github.io
        const pathPrefix = window.location.pathname.startsWith('/agora/') || window.location.pathname === '/agora'
          ? '/agora'
          : '';
        if (pathPrefix) {
          document.querySelectorAll('a[href^="/"]').forEach(function (a) {
            const raw = a.getAttribute('href') || '';
            if (!raw.startsWith(pathPrefix + '/') && raw !== pathPrefix) {
              a.setAttribute('href', pathPrefix + (raw === '/' ? '/' : raw));
            }
          });
          document.querySelectorAll('option[value^="/"]').forEach(function (opt) {
            const raw = opt.getAttribute('value') || '';
            if (!raw.startsWith(pathPrefix + '/')) {
              opt.setAttribute('value', pathPrefix + raw);
            }
          });
        }

        // Mobile Drawer Toggle
        const mobileMenuBtn = document.getElementById('btn-mobile-menu');
        const mobileDrawer = document.getElementById('mobile-nav-drawer');
        if (mobileMenuBtn && mobileDrawer) {
          mobileMenuBtn.addEventListener('click', function () {
            const isHidden = mobileDrawer.hasAttribute('hidden');
            if (isHidden) {
              mobileDrawer.removeAttribute('hidden');
              mobileMenuBtn.setAttribute('aria-expanded', 'true');
              mobileMenuBtn.textContent = '✕';
            } else {
              mobileDrawer.setAttribute('hidden', 'true');
              mobileMenuBtn.setAttribute('aria-expanded', 'false');
              mobileMenuBtn.textContent = '☰';
            }
          });
        }

        const langButtons = document.querySelectorAll('[data-lang-switch]');
        function applyLangMode(mode) {
          const validMode = mode === 'ko' || mode === 'bilingual' ? mode : 'en';
          document.body.setAttribute('data-lang', validMode);
          langButtons.forEach(function (btn) {
            btn.classList.toggle('active', btn.getAttribute('data-lang-switch') === validMode);
          });
          document.querySelectorAll('.glossary-inline-term').forEach(function (mark) {
            const attrName = validMode === 'ko' ? 'data-def-ko' : validMode === 'bilingual' ? 'data-def-bi' : 'data-def-en';
            const updatedTitle = mark.getAttribute(attrName) || mark.getAttribute('data-def-en') || '';
            mark.setAttribute('title', updatedTitle);
          });
          try {
            localStorage.setItem('agora-lang-mode', validMode);
          } catch (_e) {}
        }

        const params = new URLSearchParams(window.location.search);
        const queryLang = params.get('lang');
        let initialLang = 'en';
        try {
          initialLang = queryLang || localStorage.getItem('agora-lang-mode') || 'en';
        } catch (_e) {
          initialLang = queryLang || 'en';
        }
        applyLangMode(initialLang);

        langButtons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            const targetMode = btn.getAttribute('data-lang-switch') || 'en';
            applyLangMode(targetMode);
          });
        });

        ['issue-quick-select', 'issue-quick-select-mobile'].forEach(function (id) {
          const selectEl = document.getElementById(id);
          if (selectEl) {
            selectEl.addEventListener('change', function (e) {
              const targetUrl = e.target.value;
              if (targetUrl) {
                window.location.href = targetUrl;
              }
            });
          }
        });

        const printBtn = document.getElementById('btn-print-packet');
        if (printBtn) {
          printBtn.addEventListener('click', function () {
            document.body.setAttribute('data-print-mode', 'packet');
            window.print();
          });
        }

        window.addEventListener('afterprint', function () {
          document.body.removeAttribute('data-print-mode');
        });

        // Interactive inline glossary highlight popover
        const popover = document.getElementById('term-popover');
        const popoverWord = document.getElementById('popover-word');
        const popoverDef = document.getElementById('popover-def');
        const popoverClose = document.getElementById('popover-close');

        function showPopoverForMark(mark) {
          const currentLang = document.body.getAttribute('data-lang') || 'en';
          const attrName = currentLang === 'ko' ? 'data-def-ko' : currentLang === 'bilingual' ? 'data-def-bi' : 'data-def-en';
          const titleText = mark.getAttribute(attrName) || mark.getAttribute('title') || '';
          const termName = mark.textContent || 'Vocabulary';
          if (popover && popoverWord && popoverDef) {
            popoverWord.textContent = termName;
            popoverDef.textContent = titleText;
            popover.classList.add('visible');
          }
        }

        document.querySelectorAll('.glossary-inline-term').forEach(function (mark) {
          mark.addEventListener('click', function () {
            showPopoverForMark(mark);
          });
          mark.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              showPopoverForMark(mark);
            }
          });
        });

        if (popoverClose && popover) {
          popoverClose.addEventListener('click', function () {
            popover.classList.remove('visible');
          });
        }

        if (params.get('print') === '1') {
          window.addEventListener('load', function () {
            setTimeout(function () {
              const daySlide = params.get('slide');
              if (daySlide && window.__agoraPrintSlide) {
                window.__agoraPrintSlide(parseInt(daySlide, 10));
              } else {
                document.body.setAttribute('data-print-mode', 'packet');
                window.print();
              }
            }, 250);
          });
        }
      })();
    </script>
  </body>
</html>
