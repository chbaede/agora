            <span class="lang-ko-inline">A) {issue.articles[2].terms[0].definitionKo}</span>
          </button>
          <button type="button" class="quiz-opt-btn" data-correct="true">
            <span class="lang-en-inline">B) {issue.articles[3].terms[0].definition}</span>
            <span class="lang-ko-inline">B) {issue.articles[3].terms[0].definitionKo}</span>
          </button>
          <button type="button" class="quiz-opt-btn" data-correct="false">
            <span class="lang-en-inline">C) {issue.articles[5].terms[0].definition}</span>
            <span class="lang-ko-inline">C) {issue.articles[5].terms[0].definitionKo}</span>
