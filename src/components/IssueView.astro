---
import type { WeeklyIssue } from '../data/schema';
import Masthead from './Masthead.astro';
import ArticleCard from './ArticleCard.astro';
import ConceptExplainer from './ConceptExplainer.astro';
import BookCorner from './BookCorner.astro';
import GlossarySection from './GlossarySection.astro';
import PrintWorksheet from './PrintWorksheet.astro';

interface Props {
  issue: WeeklyIssue;
  previousIssue?: WeeklyIssue;
  nextIssue?: WeeklyIssue;
  totalIssues: number;
}

const { issue, previousIssue, nextIssue, totalIssues } = Astro.props;

const shortCatLabels: Record<string, { icon: string; en: string; ko: string; dayEn: string; dayKo: string }> = {
  'Global Affairs & Diplomacy': { icon: '🌍', en: 'Global', ko: '세계·외교', dayEn: 'Day 1 · Mon', dayKo: 'Day 1 · 월' },
  'US Current Affairs': { icon: '🇺🇸', en: 'US', ko: '미국', dayEn: 'Day 2 · Tue', dayKo: 'Day 2 · 화' },
  'Europe Current Affairs': { icon: '🇪🇺', en: 'Europe', ko: '유럽', dayEn: 'Day 3 · Wed', dayKo: 'Day 3 · 수' },
  'Economy & Business': { icon: '💶', en: 'Economy', ko: '경제', dayEn: 'Day 4 · Thu', dayKo: 'Day 4 · 목' },
  'Science & Space': { icon: '🚀', en: 'Science', ko: '과학·우주', dayEn: 'Day 5 · Fri', dayKo: 'Day 5 · 금' },
  'Environment & Future Tech': { icon: '🌱', en: 'Climate & Tech', ko: '환경·기술', dayEn: 'Day 6 · Sat', dayKo: 'Day 6 · 토' },
};

const deckPages = [
  {
    index: 0,
    num: '01',
    icon: '📋',
    shortEn: 'Cover',
    shortKo: '목차',
  },
  ...issue.articles.map((art, i) => {
    const meta = shortCatLabels[art.category] ?? {
      icon: '📰',
      en: `Day ${i + 1}`,
      ko: `Day ${i + 1}`,
      dayEn: `Day ${i + 1}`,
      dayKo: `Day ${i + 1}`,
    };
    return {
      index: i + 1,
      num: `0${i + 2}`,
      icon: meta.icon,
      shortEn: meta.en,
      shortKo: meta.ko,
    };
  }),
  {
    index: 7,
    num: '08',
    icon: '💡',
    shortEn: 'Concept & Book',
    shortKo: '개념·원서',
  },
  {
    index: 8,
    num: '09',
    icon: '🧠',
    shortEn: 'Vocab & Quiz',
    shortKo: '단어·퀴즈',
  },
];
---

<!-- Ultra-Compact Magazine Deck Controller -->
<div class="deck-controller-shell no-print" id="deck-top-anchor">
  <!-- Row 1: Strictly Single-Line Prev / 1 of 9 + Progress / Next -->
  <div class="deck-turner-bar">
    <button type="button" class="btn-page-turn prev" id="btn-prev-top" disabled>
      ← <span class="lang-en-inline">Prev</span><span class="lang-ko-inline">이전</span>
    </button>

    <div class="deck-page-indicator">
      <span class="deck-page-fraction" id="current-page-badge">1 / {deckPages.length}</span>
      <span id="reading-progress-bar" class="deck-progress-pill" title="Weekly Reading Progress">
        🎯 <span id="progress-counter-text">0/6</span>
        <span class="deck-mini-bar-outer" style="display:none;"><span id="progress-bar-fill" class="deck-mini-bar-fill"></span></span>
        <button type="button" id="btn-reset-progress" class="deck-reset-link" title="Reset progress">↺</button>
      </span>
    </div>

    <div class="deck-turner-right">
      <button type="button" class="btn-page-turn next" id="btn-next-top">
        <span class="lang-en-inline">Next</span><span class="lang-ko-inline">다음</span> →
      </button>
      <button type="button" id="btn-toggle-view-mode" class="btn-view-mode" title="Toggle 1-Page Flip vs Scroll-All">
        <span class="lang-en-inline">📜 All</span>
        <span class="lang-ko-inline">📜 전체</span>
      </button>
    </div>
  </div>

  <!-- Row 2: Single-line Horizontal Scrollable Page Tabs -->
  <nav class="deck-tabs-strip" role="tablist" aria-label="Issue Pages">
    {deckPages.map((p, idx) => (
      <button
        type="button"
        role="tab"
        class={`deck-tab-pill ${idx === 0 ? 'active' : ''}`}
        data-goto-slide={p.index}
        aria-selected={idx === 0 ? 'true' : 'false'}
      >
        <span class="deck-tab-num">{p.num}</span>
        <span>{p.icon}</span>
        <span class="lang-en-inline">{p.shortEn}</span>
        <span class="lang-ko-inline">{p.shortKo}</span>
      </button>
    ))}
  </nav>
</div>

<!-- Magazine Deck Viewport: 1 Slide Per Story/Section -->
<div class="deck-viewport" id="deck-viewport">
  <!-- Floating Left/Right Side Arrow Flippers for Desktop/Tablet -->
  <button
    type="button"
    class="deck-side-arrow left no-print"
    id="btn-side-prev"
    aria-label="Previous Page"
    title="Previous Page (←)"
    disabled
  >
    ‹
  </button>
  <button
    type="button"
    class="deck-side-arrow right no-print"
    id="btn-side-next"
    aria-label="Next Page"
    title="Next Page (→)"
  >
    ›
  </button>

  <!-- ===================================================================== -->
  <!-- PAGE 1 (SLIDE 0): COMPACT MASTHEAD, BRIEFING, KEY NUMBERS & TOC       -->
  <!-- ===================================================================== -->
  <div class="deck-slide deck-cover-slide active" data-slide-index="0">
    <Masthead
      issue={issue}
      previousIssue={previousIssue}
      nextIssue={nextIssue}
      totalIssues={totalIssues}
    />

    <div class="issue-theme-banner" style="margin-top: 0.4rem;">
      <div style="font-family: var(--font-sans); font-size: 0.72rem; font-weight: 700; color: var(--accent-civic); margin-bottom: 0.15rem;">
        <span class="lang-en-inline">EDITOR'S BRIEFING · {issue.coveragePeriod}</span>
        <span class="lang-ko-inline">에디터 브리핑 · {issue.coveragePeriod}</span>
      </div>
      <h2 class="issue-theme-title lang-en-block">{issue.themeTitle}</h2>
      <h2 class="issue-theme-title lang-ko-block">{issue.themeTitleKo}</h2>
      <p class="editors-note lang-en-block">{issue.editorsNote}</p>
      <p class="editors-note lang-ko-block">{issue.editorsNoteKo}</p>
    </div>

    <section class="hero-stats-grid" aria-label="This Week by the Numbers">
      {issue.id === '2026-W45' ? (
        <>
          <div class="stat-card">
            <div class="stat-number">~200 Nations</div>
            <div class="stat-label lang-en-block">Preparing for COP31 in Antalya under Türkiye &amp; Australia co-leadership</div>
            <div class="stat-label lang-ko-block">튀르키예·호주 공동 의장국 체제로 안탈리아 COP31 기후총회를 준비하는 참가국</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">435 Seats</div>
            <div class="stat-label lang-en-block">US House of Representatives contested in the Nov 3 midterm elections</div>
            <div class="stat-label lang-ko-block">11월 3일 미국 중간선거로 다수당이 재편된 연방 하원 전체 의석수</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">82.9% GDP</div>
            <div class="stat-label lang-en-block">European Union government debt-to-GDP ratio tracked by Eurostat</div>
            <div class="stat-label lang-ko-block">유럽통계청(Eurostat)이 발표한 유럽연합(EU) 평균 GDP 대비 국가채무비율</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">25.9B km</div>
            <div class="stat-label lang-en-block">One full Light-Day distance reached by NASA's Voyager 1 probe</div>
            <div class="stat-label lang-ko-block">NASA 보이저 1호가 인류 역사상 최초로 도달한 지구로부터 ‘1광일’ 거리</div>
          </div>
        </>
      ) : issue.id === '2026-W46' ? (
        <>
          <div class="stat-card">
            <div class="stat-number">92,000+</div>
            <div class="stat-label lang-en-block">Registered attendees at the COP31 UN Climate Summit in Antalya, Türkiye</div>
            <div class="stat-label lang-ko-block">튀르키예 안탈리아 COP31 유엔 기후변화총회에 등록한 참가자 수</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">120th</div>
            <div class="stat-label lang-en-block">Incoming US Congress holding freshman orientation &amp; lame-duck talks</div>
            <div class="stat-label lang-ko-block">워싱턴에서 당선인 오리엔테이션과 레임덕 회기에 돌입한 제120대 미국 의회</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">4.0% CPI</div>
            <div class="stat-label lang-en-block">Eurozone annual inflation rate (double the ECB's 2.0% target) on energy costs</div>
            <div class="stat-label lang-ko-block">에너지 가격 급등으로 ECB 목표치(2.0%)의 두 배가 된 유로존 물가상승률</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">900M+</div>
            <div class="stat-label lang-en-block">Galaxies mapped in 3D by ESA's Euclid space telescope (DR1-Foundation)</div>
            <div class="stat-label lang-ko-block">유럽우주국(ESA) 유클리드 우주망원경이 첫 대규모 공개한 3차원 은하 지도</div>
          </div>
        </>
      ) : (
        <>
          <div class="stat-card">
            <div class="stat-number">6 Stories</div>
            <div class="stat-label lang-en-block">{issue.coveragePeriod} · Mon–Sat Full-Page Daily Briefings</div>
            <div class="stat-label lang-ko-block">{issue.coveragePeriod} · 월~토 매일 1페이지 꽉 찬 심층 기사 6편</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">🌍 Global</div>
            <div class="stat-label lang-en-block">{issue.articles[0]?.headline}</div>
            <div class="stat-label lang-ko-block">{issue.articles[0]?.headlineKo}</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">💡 {issue.conceptOfTheWeek.category}</div>
            <div class="stat-label lang-en-block">{issue.conceptOfTheWeek.title}</div>
            <div class="stat-label lang-ko-block">{issue.conceptOfTheWeek.titleKo}</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">{issue.bookOfTheWeek.pageCount}p Book</div>
            <div class="stat-label lang-en-block">“{issue.bookOfTheWeek.title}” ({issue.bookOfTheWeek.ageRange})</div>
            <div class="stat-label lang-ko-block">『{issue.bookOfTheWeek.titleKo}』 ({issue.bookOfTheWeek.ageRange}세 권장)</div>
          </div>
        </>
      )}
    </section>

    <!-- Visual Table of Contents & 7-Day 1-Sheet Duplex Print Planner -->
    <section class="toc-overview-section no-print" aria-labelledby="toc-heading">
      <div class="section-header" style="margin-top: 0.85rem; margin-bottom: 0.65rem;">
        <h2 id="toc-heading" class="section-title" style="font-size: 1.2rem;">
          <span class="lang-en-inline">📖 7-Day Daily Reading Plan &amp; 1-Sheet Duplex Print Menu</span>
          <span class="lang-ko-inline">📖 월~일 하루 1편 읽기 목차 &amp; 1장(양면) 개별 인쇄</span>
        </h2>
        <span class="section-kicker">
          <span class="lang-en-inline">FRONT: FULL-PAGE ARTICLE &amp; SUMMARY · BACK: VOCABULARY, DISCUSSION &amp; NOTES</span>
          <span class="lang-ko-inline">[🖨️ 1장 인쇄]를 누르면 앞면(1페이지 꽉 찬 기사·핵심요약) + 뒷면(단어·토론·필기노트) 양면 1장으로 출력됩니다</span>
        </span>
      </div>

      <div class="toc-cards-grid">
        <!-- TOC Cards: Pages 2–7 (Days 1–6 · 6 Full-Page Daily Stories) -->
        {issue.articles.map((art, idx) => {
          const meta = shortCatLabels[art.category];
          const slideIdx = idx + 1;
          return (
            <div class={`toc-card ${idx === 0 ? 'toc-card-featured' : ''}`}>
              <div class="toc-card-thumb-wrap" data-goto-slide={slideIdx}>
                <img
                  src={art.imageUrl}
                  alt={art.headline}
                  class={`toc-card-thumb ${art.imageUrl.endsWith('.png') ? 'toc-thumb-contain' : ''}`}
                  loading="lazy"
                />
                <span class="toc-page-pill">{meta?.dayEn.toUpperCase() ?? `DAY ${idx + 1}`} · P.0{idx + 2}</span>
              </div>
              <div class="toc-card-body">
                <div class="toc-card-cat">
                  {meta?.icon ?? '📰'} {art.category} · 📅 {art.source.publishedDate} · ⏱️ {art.readingTimeMinutes}m
                </div>
                <h3 class="toc-card-title lang-en-block" data-goto-slide={slideIdx}>{art.headline}</h3>
                <h3 class="toc-card-title lang-ko-block" data-goto-slide={slideIdx}>{art.headlineKo}</h3>
                <div class="toc-card-actions">
                  <button type="button" class="toc-open-btn" data-goto-slide={slideIdx}>
                    <span class="lang-en-inline">Page 0{idx + 2} →</span>
                    <span class="lang-ko-inline">0{idx + 2}페이지 →</span>
                  </button>
                  <button type="button" class="btn-print-single" data-print-slide={slideIdx} title={`Print Day ${idx + 1} as a 1-Sheet Duplex Handout`}>
                    🖨️ <span class="lang-en-inline">1-Sheet</span><span class="lang-ko-inline">1장 인쇄</span>
                  </button>
                </div>
              </div>
            </div>
          );
        })}

        <!-- TOC Card: Page 8 (Day 7 · Sun · Concept & Book) -->
        <div class="toc-card">
          <div class="toc-card-thumb-wrap toc-thumb-gradient-econ" data-goto-slide="7">
            <img src={issue.bookOfTheWeek.coverImageUrl} alt={issue.bookOfTheWeek.title} class="toc-card-thumb toc-thumb-contain" loading="lazy" />
            <span class="toc-page-pill">DAY 7 (SUN) · P.08</span>
          </div>
          <div class="toc-card-body">
            <div class="toc-card-cat">💡 {issue.conceptOfTheWeek.category} + 📚 Book Pick</div>
            <h3 class="toc-card-title lang-en-block" data-goto-slide="7">{issue.conceptOfTheWeek.title} &amp; “{issue.bookOfTheWeek.title}”</h3>
            <h3 class="toc-card-title lang-ko-block" data-goto-slide="7">{issue.conceptOfTheWeek.titleKo} &amp; 『{issue.bookOfTheWeek.titleKo}』</h3>
            <div class="toc-card-actions">
              <button type="button" class="toc-open-btn" data-goto-slide="7">
                <span class="lang-en-inline">Page 08 →</span>
                <span class="lang-ko-inline">8페이지 →</span>
              </button>
              <button type="button" class="btn-print-single" data-print-slide="7" title="Print Day 7 as a 1-Sheet Duplex Handout">
                🖨️ <span class="lang-en-inline">1-Sheet</span><span class="lang-ko-inline">1장 인쇄</span>
              </button>
            </div>
          </div>
        </div>

        <!-- TOC Card: Page 9 (Glossary, Quiz & Worksheet) -->
        <div class="toc-card">
          <div class="toc-card-thumb-wrap toc-thumb-gradient-quiz" data-goto-slide="8">
            <div class="toc-quiz-graphic">🧠 18 Terms · ⚡ Quiz</div>
            <span class="toc-page-pill">REVIEW · P.09</span>
          </div>
          <div class="toc-card-body">
            <div class="toc-card-cat">Flashcards · 3-Min Quiz · Worksheet</div>
            <h3 class="toc-card-title lang-en-block" data-goto-slide="8">Weekly Vocabulary Bank &amp; Self-Check Quiz</h3>
            <h3 class="toc-card-title lang-ko-block" data-goto-slide="8">주간 핵심 어휘 사전 &amp; 3분 시사 퀴즈</h3>
            <div class="toc-card-actions">
              <button type="button" class="toc-open-btn" data-goto-slide="8">
                <span class="lang-en-inline">Page 09 →</span>
                <span class="lang-ko-inline">9페이지 →</span>
              </button>
              <button type="button" class="btn-print-single" data-print-slide="8" title="Print Vocabulary & Worksheet">
                🖨️ <span class="lang-en-inline">Print</span><span class="lang-ko-inline">인쇄</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- ===================================================================== -->
  <!-- PAGES 2 TO 7 (SLIDES 1 TO 6): DAYS 1 TO 6 · 6 FULL-PAGE DAILY STORIES -->
  <!-- ===================================================================== -->
  {issue.articles.map((article, idx) => (
    <div class="deck-slide" data-slide-index={idx + 1}>
      <ArticleCard article={article} index={idx} slideIndex={idx + 1} />
    </div>
  ))}

  <!-- ===================================================================== -->
  <!-- PAGE 8 (SLIDE 7): DAY 7 (SUN) · CONCEPT & BOOK (1-SHEET DUPLEX)       -->
  <!-- ===================================================================== -->
  <div class="deck-slide" data-slide-index="7">
    <div class="duplex-sheet-unit">
      <div class="duplex-front-page">
        <div class="print-only-sheet-header">
          <div>
            <strong>AGORA DAILY READING HANDOUT · DAY 7 (SUN)</strong> · CONCEPT OF THE WEEK &amp; BOOK PICK
          </div>
          <div>
            1-Sheet Duplex (Front: Concept &amp; Book / Back: Reflection &amp; Synthesis Notes) · Date: ____________
          </div>
        </div>

        <div class="no-print" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
          <span class="badge badge-day">
            🗓️ <span class="lang-en-inline">Day 7 (Sun) · Concept &amp; Book</span><span class="lang-ko-inline">Day 7 (일요일) · 핵심 개념 &amp; 추천 원서</span>
          </span>
          <button
            type="button"
            class="btn-print-single"
            data-print-slide="7"
            title="Print Concept & Book as a 1-Sheet 2-Sided Handout"
          >
            🖨️ <span class="lang-en-inline">1-Sheet Print</span><span class="lang-ko-inline">1장(양면) 인쇄</span>
          </button>
        </div>

        <div class="dual-feature-grid" style="margin-top: 0.25rem;">
          <ConceptExplainer concept={issue.conceptOfTheWeek} />
          <BookCorner book={issue.bookOfTheWeek} />
        </div>

        <div class="print-only-turn-hint">
          ↪ <span class="lang-en-inline">Turn sheet over (Back Side) for Book &amp; Concept Reflection Notes</span>
          <span class="lang-ko-inline">뒷면(Back Side)에 개념 적용 및 독서 토론 노트가 이어집니다</span>
        </div>
      </div>

      <div class="duplex-back-page">
        <div class="print-only-sheet-header">
          <div>
            <strong>AGORA DAY 7 STUDY &amp; BOOK REFLECTION SHEET (BACK SIDE)</strong>
          </div>
          <div>
            Student Name: ______________________
          </div>
        </div>

        <div class="print-only-daily-notes">
          <div class="daily-notes-block">
            <strong>
              <span class="lang-en-inline">✍️ 1. Concept Application — {issue.conceptOfTheWeek.title}:</span>
              <span class="lang-ko-inline">✍️ 1. 이번 주 핵심 개념({issue.conceptOfTheWeek.titleKo})을 내 말로 설명해 보기:</span>
            </strong>
            <div class="worksheet-lines">
              <div class="worksheet-line"></div>
              <div class="worksheet-line"></div>
              <div class="worksheet-line"></div>
              <div class="worksheet-line"></div>
              <div class="worksheet-line"></div>
            </div>
          </div>

          <div class="daily-notes-block" style="margin-top: 10pt;">
            <strong>
              <span class="lang-en-inline">✍️ 2. Book Discussion — “{issue.bookOfTheWeek.title}”: {issue.bookOfTheWeek.discussionPrompt}</span>
              <span class="lang-ko-inline">✍️ 2. 추천 원서 독서 토론 질문: {issue.bookOfTheWeek.discussionPromptKo}</span>
            </strong>
            <div class="worksheet-lines">
              <div class="worksheet-line"></div>
              <div class="worksheet-line"></div>
              <div class="worksheet-line"></div>
              <div class="worksheet-line"></div>
              <div class="worksheet-line"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- PAGE 9 (SLIDE 8): VOCABULARY GLOSSARY, WEEKLY QUIZ & STUDY WORKSHEET -->
  <!-- ===================================================================== -->
  <div class="deck-slide" data-slide-index="8">
    <GlossarySection issue={issue} />

    <section id="weekly-quiz-section" class="quiz-section-card no-print" aria-labelledby="quiz-heading">
      <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; border-bottom: 2px solid var(--border-strong); padding-bottom: 0.5rem; margin-bottom: 0.5rem;">
        <h2 id="quiz-heading" style="margin: 0; font-size: 1.3rem;">
          <span class="lang-en-inline">⚡ 3-Minute Weekly Current Affairs &amp; Economics Quiz</span>
          <span class="lang-ko-inline">⚡ 3분 주간 시사·경제·과학 확인 퀴즈</span>
        </h2>
      </div>

      <div class="quiz-q-block" data-quiz-q="1">
        <strong class="lang-en-block">1. What does the term “{issue.articles[1].terms[1]?.term ?? issue.articles[1].terms[0].term}” mean in this week's US Current Affairs story?</strong>
        <strong class="lang-ko-block">1. 이번 주 미국 시사 기사에 등장한 핵심 용어 ‘{issue.articles[1].terms[1]?.term ?? issue.articles[1].terms[0].term}’의 뜻으로 가장 알맞은 것은 무엇인가요?</strong>
        <div class="quiz-options">
          <button type="button" class="quiz-opt-btn" data-correct="true">
            <span class="lang-en-inline">A) {issue.articles[1].terms[1]?.definition ?? issue.articles[1].terms[0].definition}</span>
            <span class="lang-ko-inline">A) {issue.articles[1].terms[1]?.definitionKo ?? issue.articles[1].terms[0].definitionKo}</span>
          </button>
          <button type="button" class="quiz-opt-btn" data-correct="false">
            <span class="lang-en-inline">B) {issue.articles[4].terms[0].definition}</span>
            <span class="lang-ko-inline">B) {issue.articles[4].terms[0].definitionKo}</span>
          </button>
          <button type="button" class="quiz-opt-btn" data-correct="false">
            <span class="lang-en-inline">C) {issue.articles[0].terms[0].definition}</span>
            <span class="lang-ko-inline">C) {issue.articles[0].terms[0].definitionKo}</span>
          </button>
        </div>
        <div class="quiz-feedback">
          <span class="lang-en-block">✓ Correct! Example: “{issue.articles[1].terms[1]?.example ?? issue.articles[1].terms[0].example}”</span>
          <span class="lang-ko-block">✓ 정답입니다! 실전 예문: “{issue.articles[1].terms[1]?.example ?? issue.articles[1].terms[0].example}”</span>
