---
import type { WeeklyIssue } from '../data/schema';
import Masthead from './Masthead.astro';
import MunSpotlight from './MunSpotlight.astro';
import ArticleCard from './ArticleCard.astro';
import ConceptExplainer from './ConceptExplainer.astro';
import BookCorner from './BookCorner.astro';
import GlossarySection from './GlossarySection.astro';
import PrintWorksheet from './PrintWorksheet.astro';

interface Props {
  issue: WeeklyIssue;
  previousIssue?: WeeklyIssue;
  nextIssue?: WeeklyIssue;
  totalIssues: number;
}

const { issue, previousIssue, nextIssue, totalIssues } = Astro.props;

const shortCatLabels: Record<string, { icon: string; en: string; ko: string }> = {
  'US Current Affairs': { icon: '🇺🇸', en: 'US', ko: '미국' },
  'Europe Current Affairs': { icon: '🇪🇺', en: 'Europe', ko: '유럽' },
  'Economy & Business': { icon: '💶', en: 'Economy', ko: '경제' },
  'Science & Technology': { icon: '🚀', en: 'Science', ko: '과학' },
  'Environment & Global Society': { icon: '🌱', en: 'Climate', ko: '기후' },
};

const deckPages = [
  {
    index: 0,
    num: '01',
    icon: '📋',
    shortEn: 'Cover',
    shortKo: '목차',
  },
  {
    index: 1,
    num: '02',
    icon: '🇺🇳',
    shortEn: 'MUN',
    shortKo: '모의유엔',
  },
  ...issue.articles.map((art, i) => {
    const meta = shortCatLabels[art.category] ?? { icon: '📰', en: `S${i + 1}`, ko: `기사${i + 1}` };
    return {
      index: i + 2,
      num: `0${i + 3}`,
      icon: meta.icon,
      shortEn: meta.en,
      shortKo: meta.ko,
    };
  }),
  {
    index: 7,
    num: '08',
    icon: '💡',
    shortEn: 'Concept & Book',
    shortKo: '개념·원서',
  },
  {
    index: 8,
    num: '09',
    icon: '🧠',
    shortEn: 'Vocab & Quiz',
    shortKo: '단어·퀴즈',
  },
];
---

<!-- Ultra-Compact Magazine Deck Controller -->
<div class="deck-controller-shell no-print" id="deck-top-anchor">
  <!-- Row 1: Strictly Single-Line Prev / 1 of 9 + Progress / Next -->
  <div class="deck-turner-bar">
    <button type="button" class="btn-page-turn prev" id="btn-prev-top" disabled>
      ← <span class="lang-en-inline">Prev</span><span class="lang-ko-inline">이전</span>
    </button>

    <div class="deck-page-indicator">
      <span class="deck-page-fraction" id="current-page-badge">1 / {deckPages.length}</span>
      <span id="reading-progress-bar" class="deck-progress-pill" title="Weekly Reading Progress">
        🎯 <span id="progress-counter-text">0/6</span>
        <span class="deck-mini-bar-outer" style="display:none;"><span id="progress-bar-fill" class="deck-mini-bar-fill"></span></span>
        <button type="button" id="btn-reset-progress" class="deck-reset-link" title="Reset progress">↺</button>
      </span>
    </div>

    <div class="deck-turner-right">
      <button type="button" class="btn-page-turn next" id="btn-next-top">
        <span class="lang-en-inline">Next</span><span class="lang-ko-inline">다음</span> →
      </button>
      <button type="button" id="btn-toggle-view-mode" class="btn-view-mode" title="Toggle 1-Page Flip vs Scroll-All">
        <span class="lang-en-inline">📜 All</span>
        <span class="lang-ko-inline">📜 전체</span>
      </button>
    </div>
  </div>

  <!-- Row 2: Single-line Horizontal Scrollable Page Tabs -->
  <nav class="deck-tabs-strip" role="tablist" aria-label="Issue Pages">
    {deckPages.map((p, idx) => (
      <button
        type="button"
        role="tab"
        class={`deck-tab-pill ${idx === 0 ? 'active' : ''}`}
        data-goto-slide={p.index}
        aria-selected={idx === 0 ? 'true' : 'false'}
      >
        <span class="deck-tab-num">{p.num}</span>
        <span>{p.icon}</span>
        <span class="lang-en-inline">{p.shortEn}</span>
        <span class="lang-ko-inline">{p.shortKo}</span>
      </button>
    ))}
  </nav>
</div>

<!-- Magazine Deck Viewport: 1 Slide Per Story/Section -->
<div class="deck-viewport" id="deck-viewport">
  <!-- Floating Left/Right Side Arrow Flippers for Desktop/Tablet -->
  <button
    type="button"
    class="deck-side-arrow left no-print"
    id="btn-side-prev"
    aria-label="Previous Page"
    title="Previous Page (←)"
    disabled
  >
    ‹
  </button>
  <button
    type="button"
    class="deck-side-arrow right no-print"
    id="btn-side-next"
    aria-label="Next Page"
    title="Next Page (→)"
  >
    ›
  </button>

  <!-- ===================================================================== -->
  <!-- PAGE 1 (SLIDE 0): COMPACT MASTHEAD, BRIEFING, KEY NUMBERS & TOC       -->
  <!-- ===================================================================== -->
  <div class="deck-slide active" data-slide-index="0">
    <Masthead
      issue={issue}
      previousIssue={previousIssue}
      nextIssue={nextIssue}
      totalIssues={totalIssues}
    />

    <div class="issue-theme-banner" style="margin-top: 0.4rem;">
      <div style="font-family: var(--font-sans); font-size: 0.72rem; font-weight: 700; color: var(--accent-civic); margin-bottom: 0.15rem;">
        <span class="lang-en-inline">EDITOR'S BRIEFING · {issue.coveragePeriod}</span>
        <span class="lang-ko-inline">에디터 브리핑 · {issue.coveragePeriod}</span>
      </div>
      <h2 class="issue-theme-title lang-en-block">{issue.themeTitle}</h2>
      <h2 class="issue-theme-title lang-ko-block">{issue.themeTitleKo}</h2>
      <p class="editors-note lang-en-block">{issue.editorsNote}</p>
      <p class="editors-note lang-ko-block">{issue.editorsNoteKo}</p>
    </div>

    <section class="hero-stats-grid" aria-label="This Week by the Numbers">
      <div class="stat-card">
        <div class="stat-number">~200 Nations</div>
        <div class="stat-label lang-en-block">Gathering at COP31 in Antalya under Türkiye &amp; Australia co-leadership</div>
        <div class="stat-label lang-ko-block">튀르키예·호주 공동 의장국 체제로 안탈리아 COP31 기후총회에 모인 참가국</div>
      </div>
      <div class="stat-card">
        <div class="stat-number">435 Seats</div>
        <div class="stat-label lang-en-block">US House of Representatives flipped in the Nov 3 midterm elections</div>
        <div class="stat-label lang-ko-block">11월 3일 미국 중간선거로 다수당이 교체된 연방 하원 전체 의석수</div>
      </div>
      <div class="stat-card">
        <div class="stat-number">82.9% GDP</div>
        <div class="stat-label lang-en-block">European Union government debt-to-GDP ratio tracked by Eurostat</div>
        <div class="stat-label lang-ko-block">유럽통계청(Eurostat)이 발표한 유럽연합(EU) 평균 GDP 대비 국가채무비율</div>
      </div>
      <div class="stat-card">
        <div class="stat-number">25.9B km</div>
        <div class="stat-label lang-en-block">One full Light-Day distance reached by NASA's Voyager 1 probe</div>
        <div class="stat-label lang-ko-block">NASA 보이저 1호가 인류 역사상 최초로 도달한 지구로부터 ‘1광일’ 거리</div>
      </div>
    </section>

    <!-- Visual Table of Contents (Interactive Card Grid) -->
    <section class="toc-overview-section no-print" aria-labelledby="toc-heading">
      <div class="section-header" style="margin-top: 0.85rem; margin-bottom: 0.65rem;">
        <h2 id="toc-heading" class="section-title" style="font-size: 1.25rem;">
          <span class="lang-en-inline">📖 Table of Contents (Tap Any Story)</span>
          <span class="lang-ko-inline">📖 이번 주 목차 (카드를 누르면 바로 이동)</span>
        </h2>
      </div>

      <div class="toc-cards-grid">
        <!-- TOC Card: Page 2 (MUN Spotlight) -->
        <button type="button" class="toc-card toc-card-featured" data-goto-slide="1">
          <div class="toc-card-thumb-wrap">
            <img src={issue.munSpotlight.imageUrl} alt={issue.munSpotlight.topic} class="toc-card-thumb" loading="lazy" />
            <span class="toc-page-pill">P.02 · 🇺🇳 MUN</span>
          </div>
          <div class="toc-card-body">
            <div class="toc-card-cat">
              📅 {issue.munSpotlight.sources[0]?.publishedDate} · {issue.munSpotlight.committee}
            </div>
            <h3 class="toc-card-title lang-en-block">{issue.munSpotlight.topic}</h3>
            <h3 class="toc-card-title lang-ko-block">{issue.munSpotlight.topicKo}</h3>
            <span class="toc-card-cta">
              <span class="lang-en-inline">Page 02 →</span>
              <span class="lang-ko-inline">2페이지 →</span>
            </span>
          </div>
        </button>

        <!-- TOC Cards: Pages 3–7 (5 Essential Stories) -->
        {issue.articles.map((art, idx) => (
          <button type="button" class="toc-card" data-goto-slide={idx + 2}>
            <div class="toc-card-thumb-wrap">
              <img
                src={art.imageUrl}
                alt={art.headline}
                class={`toc-card-thumb ${art.imageUrl.endsWith('.png') ? 'toc-thumb-contain' : ''}`}
                loading="lazy"
              />
              <span class="toc-page-pill">P.0{idx + 3}</span>
            </div>
            <div class="toc-card-body">
              <div class="toc-card-cat">
                📅 {art.source.publishedDate} · {art.category}
              </div>
              <h3 class="toc-card-title lang-en-block">{art.headline}</h3>
              <h3 class="toc-card-title lang-ko-block">{art.headlineKo}</h3>
              <span class="toc-card-cta">
                <span class="lang-en-inline">Page 0{idx + 3} →</span>
                <span class="lang-ko-inline">0{idx + 3}페이지 →</span>
              </span>
            </div>
          </button>
        ))}

        <!-- TOC Card: Page 8 (Concept & Book) -->
        <button type="button" class="toc-card" data-goto-slide="7">
          <div class="toc-card-thumb-wrap toc-thumb-gradient-econ">
            <img src={issue.bookOfTheWeek.coverImageUrl} alt={issue.bookOfTheWeek.title} class="toc-card-thumb toc-thumb-contain" loading="lazy" />
            <span class="toc-page-pill">P.08</span>
          </div>
          <div class="toc-card-body">
            <div class="toc-card-cat">💡 {issue.conceptOfTheWeek.category} + 📚 Book Pick</div>
            <h3 class="toc-card-title lang-en-block">{issue.conceptOfTheWeek.title} &amp; “{issue.bookOfTheWeek.title}”</h3>
            <h3 class="toc-card-title lang-ko-block">{issue.conceptOfTheWeek.titleKo} &amp; 『{issue.bookOfTheWeek.titleKo}』</h3>
            <span class="toc-card-cta">
              <span class="lang-en-inline">Page 08 →</span>
              <span class="lang-ko-inline">8페이지 →</span>
            </span>
          </div>
        </button>

        <!-- TOC Card: Page 9 (Glossary, Quiz & Worksheet) -->
        <button type="button" class="toc-card" data-goto-slide="8">
          <div class="toc-card-thumb-wrap toc-thumb-gradient-quiz">
            <div class="toc-quiz-graphic">🧠 17 Terms · ⚡ Quiz</div>
            <span class="toc-page-pill">P.09</span>
          </div>
          <div class="toc-card-body">
            <div class="toc-card-cat">Flashcards · 3-Min Quiz · Worksheet</div>
            <h3 class="toc-card-title lang-en-block">Weekly Vocabulary Bank &amp; Self-Check Quiz</h3>
            <h3 class="toc-card-title lang-ko-block">주간 핵심 어휘 사전 &amp; 3분 시사 퀴즈</h3>
            <span class="toc-card-cta">
              <span class="lang-en-inline">Page 09 →</span>
              <span class="lang-ko-inline">9페이지 →</span>
            </span>
          </div>
        </button>
      </div>
    </section>
  </div>

  <!-- ===================================================================== -->
  <!-- PAGE 2 (SLIDE 1): MUN SPOTLIGHT -->
  <!-- ===================================================================== -->
  <div class="deck-slide" data-slide-index="1">
    <MunSpotlight mun={issue.munSpotlight} />
  </div>

  <!-- ===================================================================== -->
  <!-- PAGES 3 TO 7 (SLIDES 2 TO 6): 1 PAGE PER ESSENTIAL STORY -->
  <!-- ===================================================================== -->
  {issue.articles.map((article, idx) => (
    <div class="deck-slide" data-slide-index={idx + 2}>
      <ArticleCard article={article} index={idx} />
    </div>
  ))}

  <!-- ===================================================================== -->
  <!-- PAGE 8 (SLIDE 7): CONCEPT OF THE WEEK & WEEKLY ENGLISH BOOK PICK -->
  <!-- ===================================================================== -->
  <div class="deck-slide" data-slide-index="7">
    <div class="dual-feature-grid" style="margin-top: 0.25rem;">
      <ConceptExplainer concept={issue.conceptOfTheWeek} />
      <BookCorner book={issue.bookOfTheWeek} />
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- PAGE 9 (SLIDE 8): VOCABULARY GLOSSARY, WEEKLY QUIZ & STUDY WORKSHEET -->
  <!-- ===================================================================== -->
  <div class="deck-slide" data-slide-index="8">
    <GlossarySection issue={issue} />

    <section id="weekly-quiz-section" class="quiz-section-card no-print" aria-labelledby="quiz-heading">
      <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; border-bottom: 2px solid var(--border-strong); padding-bottom: 0.5rem; margin-bottom: 0.5rem;">
        <h2 id="quiz-heading" style="margin: 0; font-size: 1.3rem;">
          <span class="lang-en-inline">⚡ 3-Minute Weekly Current Affairs &amp; Economics Quiz</span>
          <span class="lang-ko-inline">⚡ 3분 주간 시사·경제 확인 퀴즈</span>
        </h2>
      </div>

      <div class="quiz-q-block" data-quiz-q="1">
        <strong class="lang-en-block">1. What is created when one political party controls the US White House and another party wins a majority in Congress?</strong>
        <strong class="lang-ko-block">1. 미국에서 백악관(대통령)과 의회 다수당을 서로 다른 정당이 차지하는 정치 구도를 무엇이라고 부르나요?</strong>
        <div class="quiz-options">
          <button type="button" class="quiz-opt-btn" data-correct="true">
            <span class="lang-en-inline">A) Divided government</span>
            <span class="lang-ko-inline">A) 분점 정부 (Divided government)</span>
          </button>
          <button type="button" class="quiz-opt-btn" data-correct="false">
            <span class="lang-en-inline">B) Unanimity rule</span>
            <span class="lang-ko-inline">B) 만장일치제 (Unanimity rule)</span>
          </button>
          <button type="button" class="quiz-opt-btn" data-correct="false">
            <span class="lang-en-inline">C) Fiscal stimulus</span>
            <span class="lang-ko-inline">C) 재정 부양책 (Fiscal stimulus)</span>
          </button>
        </div>
        <div class="quiz-feedback">
          <span class="lang-en-block">✓ Correct! Under divided government, both parties must negotiate bipartisan compromises to pass federal budgets and laws.</span>
          <span class="lang-ko-block">✓ 정답입니다! 분점 정부(Divided government)에서는 예산안과 법안 통과를 위해 여야 간 초당적(bipartisan) 타협이 필수적입니다.</span>
        </div>
      </div>

      <div class="quiz-q-block" data-quiz-q="2">
        <strong class="lang-en-block">2. Why do economists compare a country's national debt to its GDP (Gross Domestic Product) instead of looking only at the raw debt number?</strong>
        <strong class="lang-ko-block">2. 경제학자들이 국가 부채를 볼 때 단순 금액이 아니라 ‘GDP 대비 국가채무비율’을 확인하는 이유는 무엇인가요?</strong>
        <div class="quiz-options">
          <button type="button" class="quiz-opt-btn" data-correct="false">
            <span class="lang-en-inline">A) Because GDP measures distance in space</span>
            <span class="lang-ko-inline">A) 우주 거리를 재기 위해서</span>
          </button>
          <button type="button" class="quiz-opt-btn" data-correct="true">
            <span class="lang-en-inline">B) Because comparing debt to annual economic output shows how affordable the debt is</span>
            <span class="lang-ko-inline">B) 연간 경제 생산 규모(GDP)와 비교해야 실제 상환 능력을 알 수 있어서</span>
          </button>
          <button type="button" class="quiz-opt-btn" data-correct="false">
            <span class="lang-en-inline">C) Because eurozone countries have no taxes</span>
            <span class="lang-ko-inline">C) 유로존 국가에는 세금이 없어서</span>
          </button>
        </div>
        <div class="quiz-feedback">
          <span class="lang-en-block">✓ Spot on! Just like comparing a loan to a family's annual income, the debt-to-GDP ratio shows whether borrowing matches the size of the economy.</span>
          <span class="lang-ko-block">✓ 정답입니다! 가계 부채를 연 소득과 비교하듯, 국가 부채도 연간 경제 규모인 GDP와 비교해야 재정 건전성을 정확히 판단할 수 있습니다.</span>
        </div>
      </div>

      <div class="quiz-q-block" data-quiz-q="3">
        <strong class="lang-en-block">3. At a distance of one light-day (~25.9 billion km), how long does a round-trip radio signal (message + reply) take between Earth and Voyager 1?</strong>
        <strong class="lang-ko-block">3. 지구에서 ‘1광일(약 259억 km)’ 떨어진 보이저 1호에 전파 신호를 보내고 답장을 받기까지 왕복 몇 시간이 걸리나요?</strong>
        <div class="quiz-options">
          <button type="button" class="quiz-opt-btn" data-correct="false">
            <span class="lang-en-inline">A) 12 hours</span>
            <span class="lang-ko-inline">A) 12시간</span>
          </button>
          <button type="button" class="quiz-opt-btn" data-correct="false">
            <span class="lang-en-inline">B) 24 hours</span>
            <span class="lang-ko-inline">B) 24시간</span>
          </button>
          <button type="button" class="quiz-opt-btn" data-correct="true">
            <span class="lang-en-inline">C) 48 hours (24 hours there + 24 hours back)</span>
            <span class="lang-ko-inline">C) 왕복 48시간 (가는 데 24시간 + 오는 데 24시간)</span>
          </button>
        </div>
        <div class="quiz-feedback">
          <span class="lang-en-block">✓ Exactly right! Radio waves travel at the speed of light, taking 24 hours to reach Voyager 1 and another 24 hours for its reply to return to Earth.</span>
          <span class="lang-ko-block">✓ 정답입니다! 전파는 빛의 속도로 이동하므로 가는 데 24시간, 보이저 1호의 응답이 돌아오는 데 24시간으로 총 48시간이 걸립니다.</span>
        </div>
      </div>
    </section>

    <PrintWorksheet issue={issue} />
  </div>
</div>

<!-- Bottom Page Turner Bar (Clean Single-Line: Prev | 1 / 9 | Next) -->
<div class="deck-turner-bar deck-turner-bottom no-print">
  <button type="button" class="btn-page-turn prev" id="btn-prev-bottom" disabled>
    ← <span class="lang-en-inline">Prev</span><span class="lang-ko-inline">이전</span>
  </button>

  <span class="deck-page-fraction" id="bottom-page-badge">1 / {deckPages.length}</span>

  <button type="button" class="btn-page-turn next" id="btn-next-bottom">
    <span class="lang-en-inline">Next</span><span class="lang-ko-inline">다음</span> →
  </button>
</div>

<script is:inline define:vars={{ totalSlidesCount: deckPages.length, issueId: issue.id }}>
  (function () {
    // 1. Horizontal Magazine Deck Page Controller
    const slides = Array.from(document.querySelectorAll('.deck-slide'));
    const tabButtons = Array.from(document.querySelectorAll('.deck-tab-pill'));
    const gotoTriggers = Array.from(document.querySelectorAll('[data-goto-slide]'));

    const prevTop = document.getElementById('btn-prev-top');
    const nextTop = document.getElementById('btn-next-top');
    const prevBottom = document.getElementById('btn-prev-bottom');
    const nextBottom = document.getElementById('btn-next-bottom');
    const sidePrev = document.getElementById('btn-side-prev');
    const sideNext = document.getElementById('btn-side-next');

    const pageBadge = document.getElementById('current-page-badge');
    const bottomPageBadge = document.getElementById('bottom-page-badge');
    const viewModeBtn = document.getElementById('btn-toggle-view-mode');
    const topAnchor = document.getElementById('deck-top-anchor');

    const totalSlides = slides.length || totalSlidesCount;
    let currentSlide = 0;
    let isScrollAllMode = false;

    function goToSlide(targetIdx, shouldScroll) {
      if (isScrollAllMode) {
        isScrollAllMode = false;
        document.body.classList.remove('deck-scroll-all');
        updateViewModeButtonText();
      }

      const clamped = Math.max(0, Math.min(totalSlides - 1, targetIdx));
      const direction = clamped >= currentSlide ? 'right' : 'left';
      currentSlide = clamped;

      slides.forEach(function (slide, idx) {
        const active = idx === currentSlide;
        slide.classList.toggle('active', active);
        slide.classList.remove('anim-right', 'anim-left');
        if (active) {
          slide.classList.add(direction === 'right' ? 'anim-right' : 'anim-left');
        }
      });

      tabButtons.forEach(function (tab, idx) {
        const active = idx === currentSlide;
        tab.classList.toggle('active', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        if (active && tab.scrollIntoView) {
          tab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });

      const fractionText = (currentSlide + 1) + ' / ' + totalSlides;
      if (pageBadge) pageBadge.textContent = fractionText;
      if (bottomPageBadge) bottomPageBadge.textContent = fractionText;

      const isFirst = currentSlide === 0;
      const isLast = currentSlide === totalSlides - 1;

      [prevTop, prevBottom, sidePrev].forEach(function (btn) {
        if (btn) btn.disabled = isFirst;
      });
      [nextTop, nextBottom, sideNext].forEach(function (btn) {
        if (btn) btn.disabled = isLast;
      });

      if (shouldScroll && topAnchor) {
        const rect = topAnchor.getBoundingClientRect();
        if (rect.top < 0 || rect.top > 120) {
          topAnchor.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }

    gotoTriggers.forEach(function (el) {
      el.addEventListener('click', function () {
        const idx = parseInt(el.getAttribute('data-goto-slide') || '0', 10);
        goToSlide(idx, true);
      });
    });

    [prevTop, prevBottom, sidePrev].forEach(function (btn) {
      if (btn) {
        btn.addEventListener('click', function () {
          if (currentSlide > 0) goToSlide(currentSlide - 1, true);
        });
      }
    });

    [nextTop, nextBottom, sideNext].forEach(function (btn) {
      if (btn) {
        btn.addEventListener('click', function () {
          if (currentSlide < totalSlides - 1) goToSlide(currentSlide + 1, true);
        });
      }
    });

    // Keyboard Left / Right arrow support
    document.addEventListener('keydown', function (e) {
      if (isScrollAllMode) return;
      const tag = (e.target && e.target.tagName) ? e.target.tagName.toLowerCase() : '';
      if (tag === 'input' || tag === 'select' || tag === 'textarea') return;
      if (e.key === 'ArrowRight' && currentSlide < totalSlides - 1) {
        goToSlide(currentSlide + 1, true);
      } else if (e.key === 'ArrowLeft' && currentSlide > 0) {
        goToSlide(currentSlide - 1, true);
      }
    });

    // Mobile Touch Swipe Left / Right support
    const viewport = document.getElementById('deck-viewport');
    let touchStartX = 0;
    let touchStartY = 0;
    if (viewport) {
      viewport.addEventListener('touchstart', function (e) {
        if (e.changedTouches && e.changedTouches[0]) {
          touchStartX = e.changedTouches[0].screenX;
          touchStartY = e.changedTouches[0].screenY;
        }
      }, { passive: true });

      viewport.addEventListener('touchend', function (e) {
        if (isScrollAllMode || !e.changedTouches || !e.changedTouches[0]) return;
        const dx = e.changedTouches[0].screenX - touchStartX;
        const dy = e.changedTouches[0].screenY - touchStartY;
        if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.4) {
          if (dx < 0 && currentSlide < totalSlides - 1) {
            goToSlide(currentSlide + 1, true);
          } else if (dx > 0 && currentSlide > 0) {
            goToSlide(currentSlide - 1, true);
          }
        }
      }, { passive: true });
    }

    function updateViewModeButtonText() {
      if (!viewModeBtn) return;
      if (isScrollAllMode) {
        viewModeBtn.innerHTML = '<span class="lang-en-inline">📖 Flip</span><span class="lang-ko-inline">📖 넘김</span>';
      } else {
        viewModeBtn.innerHTML = '<span class="lang-en-inline">📜 All</span><span class="lang-ko-inline">📜 전체</span>';
      }
    }

    if (viewModeBtn) {
      viewModeBtn.addEventListener('click', function () {
        isScrollAllMode = !isScrollAllMode;
        document.body.classList.toggle('deck-scroll-all', isScrollAllMode);
        updateViewModeButtonText();
      });
    }

    goToSlide(0, false);

    // 2. Reading Progress Tracker
    const STORAGE_KEY = 'agora-read-items-' + issueId;
    const readButtons = document.querySelectorAll('[data-read-toggle]');
    const progressFill = document.getElementById('progress-bar-fill');
    const progressText = document.getElementById('progress-counter-text');
    const resetBtn = document.getElementById('btn-reset-progress');
    let readSet = new Set();

    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      if (Array.isArray(saved)) readSet = new Set(saved);
    } catch (_e) {}

    function renderReadProgress() {
      const total = readButtons.length || 6;
      const done = readSet.size;
      const pct = Math.round((done / total) * 100);
      if (progressFill) progressFill.style.width = pct + '%';
      if (progressText) progressText.textContent = done + '/' + total;

      readButtons.forEach(function (btn) {
        const id = btn.getAttribute('data-read-toggle');
        const isDone = id && readSet.has(id);
        btn.classList.toggle('completed', Boolean(isDone));
        btn.textContent = isDone ? '✓ Read' : '○ Mark Read';
      });
    }

    readButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const id = btn.getAttribute('data-read-toggle');
        if (!id) return;
        if (readSet.has(id)) {
          readSet.delete(id);
        } else {
          readSet.add(id);
        }
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(Array.from(readSet)));
        } catch (_e) {}
        renderReadProgress();
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        readSet.clear();
        try {
          localStorage.removeItem(STORAGE_KEY);
        } catch (_e) {}
        renderReadProgress();
      });
    }
    renderReadProgress();

    // 3. Interactive MUN Delegate Vote Poll (Language-aware!)
    const voteButtons = document.querySelectorAll('[data-mun-vote]');
    const voteResponse = document.getElementById('mun-vote-response');
    const voteResponseEn = document.getElementById('mun-vote-response-en');
    const voteResponseKo = document.getElementById('mun-vote-response-ko');

    voteButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const choice = btn.getAttribute('data-mun-vote');
        voteButtons.forEach(function (b) {
          b.classList.remove('selected-pro', 'selected-con');
        });
        if (choice === 'pro') {
          btn.classList.add('selected-pro');
          if (voteResponse && voteResponseEn && voteResponseKo) {
            voteResponse.style.display = 'block';
            voteResponseEn.textContent =
              '✓ You voted FOR the motion! Tip for your opening speech: Emphasize binding solar/wind grid investments and preventing carbon leakage.';
            voteResponseKo.textContent =
              '✓ 찬성(FOR) 표결을 선택하셨습니다! 기조연설 팁: 구속력 있는 친환경 전력망 투자와 탄소 누출 방지의 중요성을 강조해 보세요.';
          }
        } else {
          btn.classList.add('selected-con');
          if (voteResponse && voteResponseEn && voteResponseKo) {
            voteResponse.style.display = 'block';
            voteResponseEn.textContent =
              '✓ You voted AGAINST the motion! Tip for your opening speech: Emphasize fair development timelines and technology transfer over punitive border taxes.';
            voteResponseKo.textContent =
              '✓ 반대(AGAINST) 표결을 선택하셨습니다! 기조연설 팁: 처벌적 국경세 대신 기술 이전과 공정한 전환 일정을 강조해 보세요.';
          }
        }
      });
    });

    // 4. Interactive 3-Question Quiz
    document.querySelectorAll('.quiz-q-block').forEach(function (block) {
      const opts = block.querySelectorAll('.quiz-opt-btn');
      const feedback = block.querySelector('.quiz-feedback');
      opts.forEach(function (opt) {
        opt.addEventListener('click', function () {
          opts.forEach(function (o) {
            o.classList.remove('correct', 'wrong');
          });
          const isCorrect = opt.getAttribute('data-correct') === 'true';
          opt.classList.add(isCorrect ? 'correct' : 'wrong');
          if (feedback) {
            feedback.classList.add('visible');
          }
        });
      });
    });
  })();
</script>
