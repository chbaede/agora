---
import { renderBodyWithHighlights, type Article } from '../data/schema';

interface Props {
  article: Article;
  index: number;
  slideIndex?: number;
}

const { article, index, slideIndex = index + 2 } = Astro.props;
const dayNum = index + 2; // Day 2 (Tue) through Day 6 (Sat)
const dayNamesEn = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const dayNamesKo = ['월', '화', '수', '목', '금', '토', '일'];
const dayLabelEn = `Day ${dayNum} (${dayNamesEn[dayNum - 1]})`;
const dayLabelKo = `Day ${dayNum} (${dayNamesKo[dayNum - 1]}요일)`;

function getCategoryBadgeClass(category: string): string {
  if (category.includes('Science') || category.includes('Environment')) return 'badge-science';
  if (category.includes('Economy')) return 'badge-econ';
  return 'badge-civic';
}
---

<article class="article-card duplex-sheet-unit" data-category={article.category} data-read-item={article.id}>
  <!-- =================================================================== -->
  <!-- DUPLEX FRONT SIDE (PAGE 1 OF SHEET): ARTICLE READING & PHOTO        -->
  <!-- =================================================================== -->
  <div class="duplex-front-page">
    <div class="print-only-sheet-header">
      <div>
        <strong>AGORA DAILY READING HANDOUT · {dayLabelEn.toUpperCase()}</strong> · STORY #{index + 1} ({article.category})
      </div>
      <div>
        1-Sheet Duplex (Front: Article / Back: Vocab &amp; Notes) · Date: ____________
      </div>
    </div>

    <div class="article-meta-top">
      <div style="display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
        <span class="badge badge-day">
          🗓️ <span class="lang-en-inline">{dayLabelEn}</span><span class="lang-ko-inline">{dayLabelKo}</span>
        </span>
        <span class={`badge ${getCategoryBadgeClass(article.category)}`}>
          STORY #{index + 1} · {article.category}
        </span>
        <span class="badge badge-date" title="Original Article Publication Date">
          📅 <span class="lang-en-inline">Article Date:</span><span class="lang-ko-inline">기사 날짜:</span> {article.source.publishedDate}
        </span>
        <span class="badge badge-neutral">📰 {article.source.publisher}</span>
      </div>
      <div class="no-print" style="display: flex; align-items: center; gap: 0.4rem; flex-wrap: nowrap;">
        <button
          type="button"
          class="btn-print-single"
          data-print-slide={slideIndex}
          title="Print this story as a 1-sheet 2-sided (duplex) handout"
        >
          🖨️ <span class="lang-en-inline">1-Sheet Print</span><span class="lang-ko-inline">1장(양면) 인쇄</span>
        </button>
        <button type="button" class="btn-mark-read" data-read-toggle={article.id}>
          ○ Mark Read
        </button>
      </div>
    </div>

    <h3 class="article-headline lang-en-block">{article.headline}</h3>
    <h3 class="article-headline lang-ko-block">{article.headlineKo}</h3>

    <p class="article-subheadline lang-en-block">{article.subheadline}</p>
    <p class="article-subheadline lang-ko-block">{article.subheadlineKo}</p>

    {article.imageUrl && (
      <figure class="editorial-figure">
        <img
          src={article.imageUrl}
          alt={article.imageCaption}
          class={`editorial-img ${article.imageUrl.endsWith('.png') ? 'editorial-img-contain' : ''}`}
          loading="lazy"
        />
        <figcaption class="editorial-figcaption">
          <div>
            <span class="lang-en-block">📸 {article.imageCaption}</span>
            <span class="lang-ko-block">📸 {article.imageCaptionKo}</span>
          </div>
          <span class="photo-credit-badge">Photo: {article.imageCredit}</span>
        </figcaption>
      </figure>
    )}

    <div class="article-body">
      {article.body.map((para, i) => (
        <div>
          <p class="lang-en-block" set:html={renderBodyWithHighlights(para, article.terms)} />
          {article.bodyKo?.[i] && <p class="lang-ko-block">{article.bodyKo[i]}</p>}
        </div>
      ))}
    </div>

    <div class="article-source-row">
      <span>
        <strong>Source:</strong>{' '}
        <a href={article.source.url} target="_blank" rel="noopener noreferrer">
          {article.source.publisher} — {article.source.title}
        </a>
      </span>
      <span>📅 Published: {article.source.publishedDate} · Level: {article.difficulty} ({article.readingTimeMinutes} min)</span>
    </div>

    <div class="print-only-turn-hint">
      ↪ <span class="lang-en-inline">Turn sheet over (Back Side) for Key Vocabulary, Critical Thinking &amp; Daily Summary Notes</span>
      <span class="lang-ko-inline">뒷면(Back Side)에 핵심 영단어장, 토론 질문 및 3줄 요약 노트가 이어집니다</span>
    </div>
  </div>

  <!-- =================================================================== -->
  <!-- DUPLEX BACK SIDE (PAGE 2 OF SHEET): VOCABULARY, DISCUSSION & NOTES  -->
  <!-- =================================================================== -->
  <div class="duplex-back-page">
    <div class="print-only-sheet-header">
      <div>
        <strong>AGORA DAILY STUDY &amp; VOCABULARY SHEET (BACK SIDE)</strong> · STORY #{index + 1}: {article.category}
      </div>
      <div>
        Student Name: ______________________
      </div>
    </div>

    <div class="article-takeaways-grid">
      <div class="why-matters-box">
        <span class="box-label">
          <span class="lang-en-inline">💡 WHY IT MATTERS FOR YOU</span>
          <span class="lang-ko-inline">💡 왜 중요할까요? (핵심 배경과 시사점)</span>
        </span>
        <ul class="why-matters-list">
          {article.whyItMatters.map((point, i) => (
            <li>
              <span class="lang-en-block">{point}</span>
              {article.whyItMattersKo?.[i] && <span class="lang-ko-block">{article.whyItMattersKo[i]}</span>}
            </li>
          ))}
        </ul>
      </div>

      <div class="think-box">
        <span class="box-label">
          <span class="lang-en-inline">💬 CRITICAL THINKING &amp; DISCUSSION QUESTION</span>
          <span class="lang-ko-inline">💬 가족·수업 시간 토론 질문</span>
        </span>
        <p class="lang-en-block" style="margin: 0; font-size: 0.95rem; font-style: italic;">“{article.thinkAboutIt}”</p>
        <p class="lang-ko-block" style="margin: 0; font-size: 0.93rem;">“{article.thinkAboutItKo}”</p>
      </div>
    </div>

    <div class="article-terms-strip">
      <strong>
        <span class="lang-en-inline">📚 Key Vocabulary &amp; Concepts in This Story:</span>
        <span class="lang-ko-inline">📚 이 기사의 핵심 영단어 및 시사·경제 용어:</span>
      </strong>
      <div class="article-terms-list">
        {article.terms.map((t) => (
          <div class="article-term-item">
            <div>
              <strong>□ {t.term}</strong> <em>({t.partOfSpeech})</em>:{' '}
              <span class="lang-en-block">{t.definition}</span>
              <span class="lang-ko-block">{t.definitionKo}</span>
            </div>
            <div class="article-term-example">
              <em>Example:</em> “{t.example}”
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Print-Only Daily Handwritten Reflection & Vocabulary Practice Box (Back Side Bottom) -->
    <div class="print-only-daily-notes">
      <div class="daily-notes-block">
        <strong>
          <span class="lang-en-inline">✍️ 1. Key Takeaway &amp; My Answer to Today's Discussion Question (Summarize in 2–3 sentences):</span>
          <span class="lang-ko-inline">✍️ 1. 오늘 읽은 기사 핵심 요약 및 토론 질문에 대한 나의 생각 (영어 또는 한국어로 2~3문장 작성):</span>
        </strong>
        <div class="worksheet-lines">
          <div class="worksheet-line"></div>
          <div class="worksheet-line"></div>
          <div class="worksheet-line"></div>
          <div class="worksheet-line"></div>
        </div>
      </div>

      <div class="daily-notes-block" style="margin-top: 8pt;">
        <strong>
          <span class="lang-en-inline">✍️ 2. Vocabulary in Action (Write 2 sentences of your own using today's Key Words):</span>
          <span class="lang-ko-inline">✍️ 2. 오늘 배운 핵심 영단어(Key Vocabulary)를 활용해 나만의 영어 문장 2개 만들기:</span>
        </strong>
        <div class="worksheet-lines">
          <div class="worksheet-line"></div>
          <div class="worksheet-line"></div>
          <div class="worksheet-line"></div>
        </div>
      </div>
    </div>
  </div>
</article>
