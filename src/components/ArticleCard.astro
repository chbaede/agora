---
import { renderBodyWithHighlights, type Article } from '../data/schema';

interface Props {
  article: Article;
  index: number;
}

const { article, index } = Astro.props;

function getCategoryBadgeClass(category: string): string {
  if (category.includes('Science') || category.includes('Environment')) return 'badge-science';
  if (category.includes('Economy')) return 'badge-econ';
  return 'badge-civic';
}
---

<article class="article-card" data-category={article.category} data-read-item={article.id}>
  <div class="article-meta-top">
    <div style="display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap;">
      <span class={`badge ${getCategoryBadgeClass(article.category)}`}>
        STORY #{index + 1} · {article.category}
      </span>
      <span class="badge badge-date" title="Original Article Publication Date">
        📅 <span class="lang-en-inline">Article Date:</span><span class="lang-ko-inline">기사 날짜:</span> {article.source.publishedDate}
      </span>
      <span class="badge badge-neutral">📰 {article.source.publisher}</span>
      <span class="badge badge-neutral">{article.region}</span>
    </div>
    <div style="display: flex; align-items: center; gap: 0.55rem;">
      <span>⏱️ {article.readingTimeMinutes} min</span>
      <button type="button" class="btn-mark-read no-print" data-read-toggle={article.id}>
        ○ Mark Read
      </button>
    </div>
  </div>

  <h3 class="article-headline lang-en-block">{article.headline}</h3>
  <h3 class="article-headline lang-ko-block">{article.headlineKo}</h3>

  <p class="article-subheadline lang-en-block">{article.subheadline}</p>
  <p class="article-subheadline lang-ko-block">{article.subheadlineKo}</p>

  {article.imageUrl && (
    <figure class="editorial-figure">
      <img
        src={article.imageUrl}
        alt={article.imageCaption}
        class={`editorial-img ${article.imageUrl.endsWith('.png') ? 'editorial-img-contain' : ''}`}
        loading="lazy"
      />
      <figcaption class="editorial-figcaption">
        <div>
          <span class="lang-en-block">📸 {article.imageCaption}</span>
          <span class="lang-ko-block">📸 {article.imageCaptionKo}</span>
        </div>
        <span class="photo-credit-badge">Photo: {article.imageCredit}</span>
      </figcaption>
    </figure>
  )}

  <div class="article-body">
    {article.body.map((para, i) => (
      <div>
        <p class="lang-en-block" set:html={renderBodyWithHighlights(para, article.terms)} />
        {article.bodyKo?.[i] && <p class="lang-ko-block">{article.bodyKo[i]}</p>}
      </div>
    ))}
  </div>

  <div class="article-takeaways-grid">
    <div class="why-matters-box">
      <span class="box-label">
        <span class="lang-en-inline">💡 WHY IT MATTERS FOR YOU</span>
        <span class="lang-ko-inline">💡 왜 중요할까요? (핵심 배경과 시사점)</span>
      </span>
      <ul class="why-matters-list">
        {article.whyItMatters.map((point, i) => (
          <li>
            <span class="lang-en-block">{point}</span>
            {article.whyItMattersKo?.[i] && <span class="lang-ko-block">{article.whyItMattersKo[i]}</span>}
          </li>
        ))}
      </ul>
    </div>

    <div class="think-box">
      <span class="box-label">
        <span class="lang-en-inline">💬 CRITICAL THINKING &amp; DISCUSSION QUESTION</span>
        <span class="lang-ko-inline">💬 가족·수업 시간 토론 질문</span>
      </span>
      <p class="lang-en-block" style="margin: 0; font-size: 0.95rem; font-style: italic;">“{article.thinkAboutIt}”</p>
      <p class="lang-ko-block" style="margin: 0; font-size: 0.93rem;">“{article.thinkAboutItKo}”</p>
    </div>
  </div>

  <div class="article-terms-strip">
    <strong>
      <span class="lang-en-inline">Key Vocabulary &amp; Concepts in This Story:</span>
      <span class="lang-ko-inline">이 기사의 핵심 영단어 및 시사·경제 용어:</span>
    </strong>
    <div class="article-terms-list">
      {article.terms.map((t) => (
        <div>
          <strong>{t.term}</strong> <em>({t.partOfSpeech})</em>:{' '}
          <span class="lang-en-block">{t.definition}</span>
          <span class="lang-ko-block">{t.definitionKo}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="article-source-row">
    <span>
      <strong>Source:</strong>{' '}
      <a href={article.source.url} target="_blank" rel="noopener noreferrer">
        {article.source.publisher} — {article.source.title}
      </a>
    </span>
    <span>📅 Published: {article.source.publishedDate}</span>
  </div>
</article>
