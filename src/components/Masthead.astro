---
import type { WeeklyIssue } from '../data/schema';

interface Props {
  issue: WeeklyIssue;
  previousIssue?: WeeklyIssue;
  nextIssue?: WeeklyIssue;
  totalIssues: number;
}

const { issue } = Astro.props;
---

<section class="masthead">
  <div class="masthead-compact-row">
    <div class="masthead-brand-group">
      <h1 class="masthead-title">AGORA</h1>
      <div class="masthead-sub-wrap">
        <p class="masthead-subtitle lang-en-block">
          Weekly US &amp; European Current Affairs, Science, Economics &amp; Model UN Digest
        </p>
        <p class="masthead-subtitle lang-ko-block">
          국제학교 중학생과 부모님을 위한 주간 미국·유럽 시사·과학·경제 및 모의유엔(MUN) 브리핑
        </p>
      </div>
    </div>

    <div class="masthead-meta-pills">
      <span class="badge badge-civic">ISSUE #{issue.issueNumber} ({issue.id})</span>
      <span class="badge badge-neutral">📅 Published: {issue.publishDate}</span>
      <span class="badge badge-neutral">🗞️ Coverage: {issue.coveragePeriod}</span>
    </div>
  </div>
</section>
