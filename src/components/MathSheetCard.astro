---
import type { MathDailySheet } from '../data/math-schema';

interface Props {
  sheet: MathDailySheet;
  weekId: string;
  weekNumber: number;
  slideIndex: number;
}

const { sheet, weekId, weekNumber, slideIndex } = Astro.props;

const frontProblems = sheet.problems.slice(0, 6);
const backProblems = sheet.problems.slice(6, 14);

function getTierBadgeClass(tier: string): string {
  if (tier === 'Warm-Up') return 'badge-science';
  if (tier === 'Standard') return 'badge-civic';
  return 'badge-econ';
}
---

<article class="article-card math-sheet-card duplex-sheet-unit" data-math-item={sheet.id}>
  <!-- =================================================================== -->
  <!-- DUPLEX FRONT SIDE (PAGE 1 OF 2): FORMULAS + PROBLEMS #1 TO #4       -->
  <!-- =================================================================== -->
  <div class="duplex-front-page">
    <div class="print-only-sheet-header">
      <div>
        <strong class="lang-en-inline">AGORA MATH LAB · BIS GRADE 8 (MYP 3) · WEEK #{weekNumber} ({weekId}) · {sheet.dayLabel.toUpperCase()} [PAGE 1 OF 2]</strong>
        <strong class="lang-ko-inline">AGORA 수학 연구소 · 독일 국제학교(BIS) 8학년 · 제{weekNumber}주 ({weekId}) · {sheet.dayLabelKo} [1 / 2 페이지]</strong>
      </div>
      <div>
        <span class="lang-en-inline">NAME: ______________________ · DATE: ____________</span>
        <span class="lang-ko-inline">이름: ______________________ · 날짜: ____________</span>
      </div>
    </div>

    <div class="article-meta-top no-print">
      <div style="display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
        <span class="badge badge-day">
          🗓️ <span class="lang-en-inline">{sheet.dayLabel}</span><span class="lang-ko-inline">{sheet.dayLabelKo}</span>
        </span>
        <span class="badge badge-civic">
          📐 <span class="lang-en-inline">{sheet.unitCode}</span><span class="lang-ko-inline">{sheet.unitCodeKo}</span>
        </span>
        <span class="badge badge-neutral">
          <span class="lang-en-inline">{sheet.problems.length} Problems · 100 Points</span>
          <span class="lang-ko-inline">총 {sheet.problems.length}문항 · 100점 만점</span>
        </span>
      </div>

      <div style="display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap;">
        <button
          type="button"
          class="btn-print-single"
          data-print-slide={slideIndex}
          title="Print this 2-page (1-sheet duplex) problem worksheet (No answers printed)"
        >
          🖨️ <span class="lang-en-inline">Print 2-Page Worksheet (Duplex)</span><span class="lang-ko-inline">문제지 2페이지(양면 1장) 인쇄</span>
        </button>
        <button type="button" class="btn-mark-read" data-math-read-toggle={sheet.id}>
          ○ Done
        </button>
      </div>
    </div>

    <h3 class="article-headline lang-en-block">{sheet.topic}</h3>
    <h3 class="article-headline lang-ko-block">{sheet.topicKo}</h3>

    <p class="article-subheadline lang-en-block">{sheet.subtitle}</p>
    <p class="article-subheadline lang-ko-block">{sheet.subtitleKo}</p>

    <!-- Compact Key Formulas & Worked Example Reference Box -->
    <div class="math-formula-banner">
      <div class="math-formula-rules">
        <strong class="box-label">
          <span class="lang-en-inline">■ KEY FORMULAS &amp; CONCEPT SUMMARY</span>
          <span class="lang-ko-inline">■ 오늘의 핵심 공식 및 개념 요약</span>
        </strong>
        <ul class="math-formula-list">
          {sheet.formulaBox.map((rule, i) => (
            <li>
              <span class="lang-en-block">{rule}</span>
              {sheet.formulaBoxKo?.[i] && <span class="lang-ko-block">{sheet.formulaBoxKo[i]}</span>}
            </li>
          ))}
        </ul>
      </div>

      <div class="math-worked-example">
        <strong class="box-label">
          <span class="lang-en-inline">■ WORKED MODEL EXAMPLE</span>
          <span class="lang-ko-inline">■ 대표 예제 풀이</span>
        </strong>
        <div class="lang-en-block" style="font-weight: 700; margin-bottom: 0.15rem;">{sheet.workedExample.problem}</div>
        <div class="lang-ko-block" style="font-weight: 700; margin-bottom: 0.15rem;">{sheet.workedExample.problemKo}</div>
        <div class="lang-en-block" style="font-size: 0.85rem;">⇒ {sheet.workedExample.steps}</div>
        <div class="lang-ko-block" style="font-size: 0.84rem;">⇒ {sheet.workedExample.stepsKo}</div>
      </div>
    </div>

    <!-- Front Page Problems (#1 to #4) -->
    <div class="math-problems-grid math-front-grid">
      {frontProblems.map((prob) => (
        <div class="math-problem-card">
          <div>
            <div class="math-prob-header">
              <span class="math-prob-num">
                <span class="lang-en-inline">Problem #{prob.number}</span>
                <span class="lang-ko-inline">문제 #{prob.number}</span>
              </span>
              <span class={`badge ${getTierBadgeClass(prob.tier)} math-tier-badge`}>
                <span class="lang-en-inline">{prob.tier} · {prob.points} pts</span>
                <span class="lang-ko-inline">{prob.tierKo} · {prob.points}점</span>
              </span>
            </div>

            <div class="math-prob-question">
              <p class="lang-en-block">{prob.question}</p>
              <p class="lang-ko-block">{prob.questionKo}</p>
            </div>
          </div>

          <div>
            <div class="math-work-space math-work-front">
              <div class="math-work-label">
                <span class="lang-en-inline">Show your step-by-step work:</span>
                <span class="lang-ko-inline">풀이 과정을 단계별로 적으시오:</span>
              </div>
              <div class="math-answer-line">
                <strong>
                  <span class="lang-en-inline">Answer:</span>
                  <span class="lang-ko-inline">정답:</span>
                </strong>{' '}
                ____________________________
              </div>
            </div>

            <!-- Interactive Screen-Only Step-by-Step Solution Toggle (Never Printed) -->
            <details class="math-solution-details no-print">
              <summary>
                <span class="lang-en-inline">👁️ Show Step-by-Step Solution &amp; Answer</span>
                <span class="lang-ko-inline">👁️ 단계별 풀이 및 정답 펼치기</span>
              </summary>
              <div class="math-solution-body">
                <div class="math-final-ans">
                  <div class="lang-en-block"><strong>✓ Answer:</strong> {prob.answer}</div>
                  <div class="lang-ko-block"><strong>✓ 정답:</strong> {prob.answerKo}</div>
                </div>
                <ol class="math-steps-list">
                  {prob.solutionSteps.map((step, idx) => (
                    <li>
                      <span class="lang-en-block">{step}</span>
                      {prob.solutionStepsKo?.[idx] && <span class="lang-ko-block">{prob.solutionStepsKo[idx]}</span>}
                    </li>
                  ))}
                </ol>
              </div>
            </details>
          </div>
        </div>
      ))}
    </div>

    <div class="print-only-turn-hint">
      <span class="lang-en-inline">[Page 1 of 2 — Front Side: Problems #1–#6] ↪ Turn sheet over for Problems #7–#14 (Standard &amp; Challenge)</span>
      <span class="lang-ko-inline">[1 / 2 페이지 — 앞면: 문제 #1~#6] ↪ 뒷면(2페이지)에 응용·심화 문제 #7~#14번이 이어집니다</span>
    </div>
  </div>

  <!-- =================================================================== -->
  <!-- DUPLEX BACK SIDE (PAGE 2 OF 2): PROBLEMS #7 TO #14 + SCORE STRIP    -->
  <!-- =================================================================== -->
  <div class="duplex-back-page">
    <div class="print-only-sheet-header">
      <div>
        <strong class="lang-en-inline">AGORA MATH LAB · BIS GRADE 8 (MYP 3) · {sheet.dayLabel.toUpperCase()} [PAGE 2 OF 2 — PROBLEMS #7–#14]</strong>
        <strong class="lang-ko-inline">AGORA 수학 연구소 · 독일 국제학교(BIS) 8학년 · {sheet.dayLabelKo} [2 / 2 페이지 — 문제 #7~#14]</strong>
      </div>
      <div>
        <span class="lang-en-inline">SCORE: ______ / 100</span>
        <span class="lang-ko-inline">점수: ______ / 100점</span>
      </div>
    </div>

    <div class="math-problems-grid math-back-grid">
      {backProblems.map((prob) => (
        <div class="math-problem-card">
          <div>
            <div class="math-prob-header">
              <span class="math-prob-num">
                <span class="lang-en-inline">Problem #{prob.number}</span>
                <span class="lang-ko-inline">문제 #{prob.number}</span>
              </span>
              <span class={`badge ${getTierBadgeClass(prob.tier)} math-tier-badge`}>
                <span class="lang-en-inline">{prob.tier} · {prob.points} pts</span>
                <span class="lang-ko-inline">{prob.tierKo} · {prob.points}점</span>
              </span>
            </div>

            <div class="math-prob-question">
              <p class="lang-en-block">{prob.question}</p>
              <p class="lang-ko-block">{prob.questionKo}</p>
            </div>
          </div>

          <div>
            <div class="math-work-space math-work-back">
              <div class="math-work-label">
                <span class="lang-en-inline">Show your step-by-step equation &amp; work:</span>
                <span class="lang-ko-inline">식과 풀이 과정을 단계별로 적으시오:</span>
              </div>
              <div class="math-answer-line">
                <strong>
                  <span class="lang-en-inline">Answer:</span>
                  <span class="lang-ko-inline">정답:</span>
                </strong>{' '}
                ____________________________
              </div>
            </div>

            <!-- Interactive Screen-Only Step-by-Step Solution Toggle (Never Printed) -->
            <details class="math-solution-details no-print">
              <summary>
                <span class="lang-en-inline">👁️ Show Step-by-Step Solution &amp; Answer</span>
                <span class="lang-ko-inline">👁️ 단계별 풀이 및 정답 펼치기</span>
              </summary>
              <div class="math-solution-body">
                <div class="math-final-ans">
                  <div class="lang-en-block"><strong>✓ Answer:</strong> {prob.answer}</div>
                  <div class="lang-ko-block"><strong>✓ 정답:</strong> {prob.answerKo}</div>
                </div>
                <ol class="math-steps-list">
                  {prob.solutionSteps.map((step, idx) => (
                    <li>
                      <span class="lang-en-block">{step}</span>
                      {prob.solutionStepsKo?.[idx] && <span class="lang-ko-block">{prob.solutionStepsKo[idx]}</span>}
                    </li>
                  ))}
                </ol>
              </div>
            </details>
          </div>
        </div>
      ))}
    </div>

    <div class="print-only-check-footer">
      <span>
        <span class="lang-en-inline">[ &nbsp; ] Part A: Warm-Up (#1–#5 · 30 pts)</span>
        <span class="lang-ko-inline">[ &nbsp; ] Part A: 기초 필수 (#1~#5 · 30점)</span>
      </span>
      <span>
        <span class="lang-en-inline">[ &nbsp; ] Part B: Standard (#6–#11 · 45 pts)</span>
        <span class="lang-ko-inline">[ &nbsp; ] Part B: 표준 응용 (#6~#11 · 45점)</span>
      </span>
      <span>
        <span class="lang-en-inline">[ &nbsp; ] Part C: Challenge (#12–#14 · 25 pts)</span>
        <span class="lang-ko-inline">[ &nbsp; ] Part C: 심화 도전 (#12~#14 · 25점)</span>
      </span>
      <span>
        <span class="lang-en-inline">Check step-by-step solutions online at agora.yocto.kr/math</span>
        <span class="lang-ko-inline">단계별 해설 및 정답 확인: agora.yocto.kr/math</span>
      </span>
    </div>
  </div>
</article>
