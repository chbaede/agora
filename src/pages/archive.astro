---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllIssues, getLatestIssue } from '../data/load-issues';

const issues = getAllIssues();
const latest = getLatestIssue();
---

<BaseLayout
  title="AGORA Archive — Read & Print All Past Weekly Issues"
  currentIssueId={latest.id}
  activeNav="archive"
>
  <section class="masthead">
    <div class="masthead-meta-row">
      <span>
        <span class="lang-en-inline">COMPLETE WEEKLY ARCHIVE</span>
        <span class="lang-ko-inline">전체 지난 호 아카이브</span>
      </span>
      <span>INSTANT WEB ACCESS &amp; ONE-CLICK A4/LETTER PRINT PACKETS</span>
    </div>

    <div class="masthead-title-block" style="padding: 1rem 0 0.5rem;">
      <h1 class="masthead-title" style="font-size: clamp(2rem, 4.5vw, 3rem);">
        Past Issues &amp; Print Library
      </h1>
      <p class="masthead-subtitle lang-en-block">
        Every weekly edition of AGORA is permanently archived here. Open any issue to read online, or click <strong>“Print Packet”</strong> to immediately print the full issue and student worksheet.
      </p>
      <p class="masthead-subtitle lang-ko-block">
        발행된 모든 주간 호를 언제든 다시 열람하고, 영어(학생용)·한국어(부모님용)·한영 병기 모드로 바로 인쇄하실 수 있습니다.
      </p>
    </div>

    <div style="margin-top: 1rem; font-family: var(--font-sans);">
      <label for="archive-search-input" style="font-size: 0.84rem; font-weight: 600; display: block; margin-bottom: 0.35rem;">
        <span class="lang-en-inline">Filter Past Issues by Keyword, Topic, Country, or Book Title:</span>
        <span class="lang-ko-inline">영어·한국어 키워드로 지난 호 검색:</span>
      </label>
      <input
        id="archive-search-input"
        type="search"
        placeholder="e.g., COP31, Midterm, Eurozone, Voyager, Kamkwamba..."
        style="width: 100%; max-width: 520px; padding: 0.55rem 0.85rem; border: 1px solid var(--border-strong); border-radius: 6px; font-family: var(--font-sans); font-size: 0.92rem;"
      />
    </div>
  </section>

  <section class="archive-grid" id="archive-list">
    {issues.map((issue) => (
      <article
        class="archive-card"
        data-search-text={`${issue.id} ${issue.publishDate} ${issue.themeTitle} ${issue.themeTitleKo} ${issue.munSpotlight.topic} ${issue.munSpotlight.topicKo} ${issue.bookOfTheWeek.title} ${issue.bookOfTheWeek.titleKo} ${issue.articles.map((a) => `${a.headline} ${a.headlineKo}`).join(' ')}`.toLowerCase()}
      >
        <div style="flex: 1 1 520px;">
          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.45rem;">
            <span class="badge badge-civic">Issue #{issue.issueNumber} ({issue.id})</span>
            <span class="badge badge-neutral">Published: {issue.publishDate}</span>
            <span class="badge badge-neutral">Coverage: {issue.coveragePeriod}</span>
          </div>

          <h2 class="lang-en-block" style="font-size: 1.4rem; margin: 0 0 0.45rem; line-height: 1.28;">
            <a href={`/issues/${issue.id}`} style="color: var(--ink-primary); text-decoration: none;">
              {issue.themeTitle}
            </a>
          </h2>
          <h2 class="lang-ko-block" style="font-size: 1.32rem; margin: 0 0 0.45rem; line-height: 1.34;">
            <a href={`/issues/${issue.id}?lang=ko`} style="color: var(--ink-primary); text-decoration: none;">
              {issue.themeTitleKo}
            </a>
          </h2>

          <p class="lang-en-block" style="margin: 0 0 0.75rem; font-size: 0.96rem; color: var(--ink-secondary);">
            {issue.editorsNote}
          </p>
          <p class="lang-ko-block" style="margin: 0 0 0.75rem; font-size: 0.94rem; color: var(--ink-secondary);">
            {issue.editorsNoteKo}
          </p>

          <div style="font-family: var(--font-sans); font-size: 0.85rem; background: var(--bg-panel); padding: 0.75rem 1rem; border-radius: 6px;">
            <div style="margin-bottom: 0.35rem;">
              <strong>🇺🇳 MUN Spotlight:</strong>{' '}
              <span class="lang-en-block">{issue.munSpotlight.topic} <em>({issue.munSpotlight.committee})</em></span>
              <span class="lang-ko-block">{issue.munSpotlight.topicKo} <em>({issue.munSpotlight.committee})</em></span>
            </div>
            <div style="margin-bottom: 0.35rem;">
              <strong>📰 5 Articles:</strong>{' '}
              <span class="lang-en-block">
                {issue.articles.map((a, i) => (
                  <span>{i > 0 ? ' · ' : ''}{a.headline}</span>
                ))}
              </span>
              <span class="lang-ko-block">
                {issue.articles.map((a, i) => (
                  <span>{i > 0 ? ' · ' : ''}{a.headlineKo}</span>
                ))}
              </span>
            </div>
            <div>
              <strong>📚 Book Pick:</strong>{' '}
              <span class="lang-en-inline"><em>{issue.bookOfTheWeek.title}</em> by {issue.bookOfTheWeek.author}</span>
              <span class="lang-ko-inline"><em>{issue.bookOfTheWeek.title}</em> ({issue.bookOfTheWeek.titleKo}) — {issue.bookOfTheWeek.author}</span>
            </div>
          </div>
        </div>

        <div class="archive-actions">
          <a href={`/issues/${issue.id}`} class="btn-secondary">
            🇺🇸 Read (English)
          </a>
          <a href={`/issues/${issue.id}?lang=ko`} class="btn-secondary">
            🇰🇷 한국어로 보기
          </a>
          <a href={`/issues/${issue.id}?lang=bilingual`} class="btn-secondary">
            🇺🇸+🇰🇷 한영 병기
          </a>
          <a href={`/issues/${issue.id}?lang=en&print=1`} class="btn-print" title="Opens this issue in English and triggers the print dialog">
            🖨️ Print Packet (EN)
          </a>
          <a href={`/issues/${issue.id}?lang=bilingual&print=1`} class="btn-secondary" title="Opens this issue in Bilingual mode and triggers the print dialog">
            🖨️ 한영 병기 인쇄
          </a>
        </div>
      </article>
    ))}
  </section>

  <script is:inline>
    (function () {
      const input = document.getElementById('archive-search-input');
      const cards = document.querySelectorAll('#archive-list .archive-card');
      if (input) {
        input.addEventListener('input', function (e) {
          const q = (e.target.value || '').trim().toLowerCase();
          cards.forEach(function (card) {
            const hay = card.getAttribute('data-search-text') || '';
            if (!q || hay.includes(q)) {
              card.style.display = '';
            } else {
              card.style.display = 'none';
            }
          });
        });
      }
    })();
  </script>
</BaseLayout>
